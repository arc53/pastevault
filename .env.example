# PostgreSQL (default)
DATABASE_URL="postgresql://username:password@localhost:5432/pastevault"
DATABASE_PROVIDER="postgresql"

# SQLite (uncomment below to use SQLite instead)
# DATABASE_URL="file:./pastevault.db"
# DATABASE_PROVIDER="sqlite"
PORT=3001
NODE_ENV=development
# Browser origins allowed to call the API with cookies (comma-separated), besides
# the server's own origin and BETTER_AUTH_URL / BETTER_AUTH_TRUSTED_ORIGINS.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=60000
MAX_PASTE_SIZE_BYTES=1048576
CLEANUP_INTERVAL_MINUTES=60
# Audit log: "off" stores no IP addresses, "truncated" keeps the /24 (IPv4) or /48 (IPv6).
# Behind a reverse proxy, "truncated" needs TRUST_PROXY, otherwise every event
# records the proxy's address.
AUDIT_IP_MODE=off
AUDIT_RETENTION_DAYS=90
# Reverse proxies whose X-Forwarded-For/-Proto/-Host headers are trusted (client IP,
# and the request origin used by the CORS/CSRF checks): "false" (default), "true"
# (any), a hop count such as 1, or a comma-separated list of addresses/CIDRs.
# Only enable it when the proxy overwrites these headers.
TRUST_PROXY=false
