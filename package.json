{
  "name": "pastevault",
  "version": "0.1.6",
  "description": "Secure end-to-end encrypted paste sharing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pastevault": "dist/cli.js"
  },
  "files": [
    "dist/",
    "frontend/.next/",
    "frontend/public/",
    "frontend/next.config.js",
    "frontend/package.json",
    "prisma.config.js",
    "prisma/",
    "scripts/"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:cli": "npm run build && npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/index.js",
    "db:push": "node scripts/prisma-runner.mjs db push",
    "db:migrate": "node scripts/prisma-runner.mjs migrate dev",
    "db:generate": "node scripts/prisma-runner.mjs generate",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build:cli && node tests/e2e-smoke.mjs",
    "prepublishOnly": "npm run build:cli",
    "postinstall": "prisma generate --config prisma.config.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arc53/pastevault.git"
  },
  "homepage": "https://pastevault.dev/",
  "bugs": {
    "url": "https://github.com/arc53/pastevault/issues"
  },
  "keywords": [
    "paste",
    "pastebin",
    "secure",
    "encryption",
    "e2ee",
    "zero-knowledge",
    "cli",
    "self-hosted",
    "markdown",
    "nextjs",
    "fastify",
    "prisma",
    "postgresql",
    "sqlite"
  ],
  "license": "GPL-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@noble/ciphers": "^2.2.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@tanstack/react-query": "^5.101.2",
    "better-auth": "^1.6.23",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "highlight.js": "^11.11.1",
    "kysely": "^0.28.17",
    "lucide-react": "^1.25.0",
    "nanoid": "^6.0.0",
    "next": "^16.2.10",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "sodium-native": "^5.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@prisma/dev": {
      "@hono/node-server": "^1.19.13"
    },
    "postcss": "$postcss"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
