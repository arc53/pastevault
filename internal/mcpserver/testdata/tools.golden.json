  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List stored secrets"
    },
    "description": "List the secrets in the local store as pv://secret/NAME handles (names and metadata only, never values). Use a handle with: pastevault run --env-file .env.pv -- <command>.",
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    },
    "name": "list_secrets",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "secrets": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "created_at": {
                "type": "string"
              },
              "handle": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "source": {
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            },
            "required": [
              "name",
              "handle",
              "kind",
              "created_at",
              "source"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "agent",
        "secrets"
      ],
      "type": "object"
    },
    "title": "List stored secrets"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Open a share"
    },
    "description": "Open a share and write it to output_path (inside the allowed roots, files 0600) or into the local secret store with save_as (then use pv://secret/NAME with pastevault run). One of them is required: the content is only returned when the MCP server runs with --allow-plaintext, allow_plaintext is true and it does not look like a secret. Opening uses a view; the last view destroys the share.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "allow_plaintext": {
          "description": "Return the text in the result. Only works when the server was started with --allow-plaintext, and never for content that looks like a secret.",
          "type": "boolean"
        },
        "output_path": {
          "description": "Write the content here: a file path, or a directory (existing, or ending in /) for multi-file shares. Must be inside the allowed roots.",
          "type": "string"
        },
        "overwrite": {
          "description": "Replace an existing output file or stored secret",
          "type": "boolean"
        },
        "ref": {
          "description": "Share link (/p/ or /f/ URL with #k=), slug, or pv://share handle",
          "minLength": 1,
          "type": "string"
        },
        "save_as": {
          "description": "Store the content in the local secret store as NAME; use it as pv://secret/NAME with pastevault run",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "name": "receive",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "burned": {
          "type": "boolean"
        },
        "content": {
          "type": [
            "null",
            "string"
          ]
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              }
            },
            "required": [
              "name",
              "size"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "kind": {
          "type": "string"
        },
        "notices": {
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "recipient": {
          "additionalProperties": false,
          "properties": {
            "fingerprint": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "fingerprint"
          ],
          "type": [
            "null",
            "object"
          ]
        },
        "saved_as": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        },
        "slug": {
          "type": "string"
        },
        "title": {
          "type": [
            "null",
            "string"
          ]
        },
        "views_remaining": {
          "type": [
            "null",
            "integer"
          ]
        },
        "withheld": {
          "type": "string"
        },
        "written_to": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "slug",
        "size_bytes",
        "burned",
        "views_remaining"
      ],
      "type": "object"
    },
    "title": "Open a share"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Request a secret"
    },
    "description": "Ask the user for a secret (API key, password, file) without it passing through the conversation. The user opens a PasteVault link signed in to their account and enters the value; it is stored encrypted on this machine and you get a pv://secret/NAME handle, never the value. If the client supports URL elicitation the link is shown to the user directly; otherwise show the returned url to the user and call request_status later.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "accept": {
          "default": "text",
          "description": "What the user may send: text (default), file or any",
          "enum": [
            "text",
            "file",
            "any"
          ],
          "type": "string"
        },
        "name": {
          "description": "What to ask for, e.g. OPENAI_API_KEY. It also becomes the store name: pv://secret/NAME",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        "reason": {
          "description": "Why you need it; shown to the user (as untrusted text) on the request page",
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "description": "How long to wait for the answer",
          "maximum": 900,
          "minimum": 10,
          "type": "integer"
        },
        "ttl": {
          "default": "10m",
          "description": "How long the request stays open, e.g. 10m or 2h",
          "pattern": "^[0-9]+[smhd]$",
          "type": "string"
        },
        "wait": {
          "default": true,
          "description": "After the user was shown the link (URL elicitation), wait for the answer. Without elicitation support the link is returned at once.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "reason"
      ],
      "type": "object"
    },
    "name": "request_secret",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "code",
        "url",
        "fingerprint",
        "expires_at",
        "status"
      ],
      "type": "object"
    },
    "title": "Ask the user for a secret"
  },
