  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Share text"
    },
    "description": "Share text end-to-end encrypted and get a link. Defaults: one view, expires in 1h. With to, the share is sealed to an agent of your account and the link carries no key. Anything sent leaves this machine, so only share what the user wants shared; never use this to move secrets the user did not ask you to send.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "expires": {
          "default": "1h",
          "description": "Expiry such as 15m, 2h or 7d",
          "pattern": "^[0-9]+[mhd]$",
          "type": "string"
        },
        "format": {
          "description": "plain (default) or markdown",
          "enum": [
            "plain",
            "markdown"
          ],
          "type": "string"
        },
        "max_views": {
          "default": 1,
          "description": "Destroy the share after this many views",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "text": {
          "description": "The text to share. It is encrypted on this machine; the server never sees it.",
          "maxLength": 1048576,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "description": "Optional title shown above the text",
          "maxLength": 200,
          "type": "string"
        },
        "to": {
          "description": "Seal the share to an agent of your account (name or pvk1_ fingerprint): the link then has no key and only that agent can open it",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
