        "max_views": {
          "default": 1,
          "description": "Destroy the share after this many views",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "paths": {
          "description": "Files to share (absolute, or relative to the first root); they must be inside the allowed roots",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 25,
          "minItems": 1,
          "type": "array"
        },
        "to": {
          "description": "Seal the share to an agent of your account (name or pvk1_ fingerprint)",
          "type": "string"
        }
