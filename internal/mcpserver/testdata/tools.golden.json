      "additionalProperties": false,
      "properties": {
        "event": {
          "description": "Only this event, e.g. share.viewed or request.fulfilled",
          "maxLength": 64,
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Maximum number of events",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "since": {
          "description": "Only events after this: 15m, 24h, 7d, or an RFC 3339 time",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "audit",
