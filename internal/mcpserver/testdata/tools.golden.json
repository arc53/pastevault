            "auto",
            "paste",
            "files"
          ],
          "type": "string"
        },
        "expires": {
          "default": "1h",
          "description": "Expiry such as 15m, 2h or 7d",
          "pattern": "^[0-9]+[mhd]$",
          "type": "string"
